{
  "openrpc": "1.2.6",
  "info": {
    "title": "lip Daemon JSON-RPC API",
    "description": "API for interacting with the lip package installer daemon.",
    "version": "4.0.0"
  },
  "methods": [
    {
      "name": "CacheClean",
      "description": "Cleans the local package cache.",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "ConfigDelete",
      "description": "Deletes a configuration key.",
      "params": [
        {
          "name": "key",
          "description": "The configuration key to delete.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "ConfigGet",
      "description": "Gets a configuration value.",
      "params": [
        {
          "name": "key",
          "description": "The configuration key to get.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "value",
        "schema": {
          "type": "string"
        }
      }
    },
    {
      "name": "ConfigList",
      "description": "Lists all configuration values.",
      "params": [],
      "result": {
        "name": "config",
        "schema": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "ConfigSet",
      "description": "Sets a configuration value.",
      "params": [
        {
          "name": "key",
          "description": "The configuration key.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "value",
          "description": "The configuration value.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "Init",
      "description": "Writes a format 4 manifest.json (a concrete native mod named after the current directory). Fails if manifest.json exists.",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "Install",
      "description": "Installs packages: path[#variant][@version], path[#variant]@branch:<name>, @tag:<name> or @rev:<40-digit commit id>, an https:// URL of a .mcmod/.zip file, or a local .mcmod/.zip file (absolute, or relative to the daemon current directory). Local directories are rejected.",
      "params": [
        {
          "name": "packages",
          "description": "List of packages to install.",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "dryRun",
          "description": "If true, simulates the installation.",
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "ignoreScripts",
          "description": "If true, ignores package scripts.",
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "noDependencies",
          "description": "If true, skips installing dependencies.",
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "rid",
          "description": "The .NET runtime identifier (e.g. \"win-x64\"). When null, it comes from the lock or the runtime lip runs on.",
          "required": false,
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "List",
      "description": "Lists installed packages from the workspace lock.",
      "params": [],
      "result": {
        "name": "packages",
        "description": "Explicitly installed packages and dependencies, each as \"name@version\".",
        "schema": {
          "type": "array",
          "items": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    {
      "name": "Migrate",
      "description": "Converts a tooth.json (format 1-3) into a format 4 manifest.json.",
      "params": [
        {
          "name": "file",
          "description": "Path to the tooth.json to convert.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "output",
          "description": "Path to the manifest.json to write.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "Uninstall",
      "description": "Uninstalls packages, given by name or by the path[#variant] they were installed from.",
      "params": [
        {
          "name": "packages",
          "description": "List of packages to uninstall.",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "dryRun",
          "description": "If true, simulates uninstallation.",
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "ignoreScripts",
          "description": "If true, ignores scripts.",
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "noDependencies",
          "description": "If true, skips dependencies.",
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "rid",
          "description": "The .NET runtime identifier (e.g. \"win-x64\"). When null, it comes from the lock or the runtime lip runs on.",
          "required": false,
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "Update",
      "description": "Updates packages to the given or newest version, or the commit a git ref names now; with an empty list, every explicitly installed package, requested again by the ref it was installed from (a branch follows its head, a tag is resolved again, a rev stays, a URL is requested again but served from the download cache, a local file is read again).",
      "params": [
        {
          "name": "packages",
          "description": "List of packages to update.",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "dryRun",
          "description": "If true, simulates update.",
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "ignoreScripts",
          "description": "If true, ignores scripts.",
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "rid",
          "description": "The .NET runtime identifier (e.g. \"win-x64\"). When null, it comes from the lock or the runtime lip runs on.",
          "required": false,
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "Versions",
      "description": "Lists the v<SemVer> tag versions of a package path, lowest first.",
      "params": [
        {
          "name": "package",
          "description": "The package to list versions for.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "versions",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "View",
      "description": "Returns the root document (tooth.json or manifest.json) of the archive a package argument points to; the argument takes the forms Install takes.",
      "params": [
        {
          "name": "package",
          "description": "The package to view.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "manifest",
        "schema": {
          "type": "string"
        }
      }
    },
    {
      "name": "PrintInfo",
      "description": "Notification from daemon to print an informational message.",
      "params": [
        {
          "name": "message",
          "description": "The message to display.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "PrintSuccess",
      "description": "Notification from daemon to print a success message.",
      "params": [
        {
          "name": "message",
          "description": "The message to display.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "PrintWarning",
      "description": "Notification from daemon to print a warning message.",
      "params": [
        {
          "name": "message",
          "description": "The message to display.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "PrintError",
      "description": "Notification from daemon to print an error message.",
      "params": [
        {
          "name": "message",
          "description": "The message to display.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "ReportProgress",
      "description": "Notification from daemon to report progress for a running operation.",
      "params": [
        {
          "name": "id",
          "description": "The progress operation identifier.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "message",
          "description": "A human-readable progress message.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "percentage",
          "description": "Progress value reported by the running operation.",
          "schema": {
            "type": "number"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "null"
        }
      }
    }
  ]
}
