{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LiteLDev/lip/raw/main/protocol/manifest.schema.json",
  "title": "lip manifest.json (format bf45b1)",
  "description": "Keys not described here are ignored. Two targets with the same variant must not write the same selector keys (platform, runtime) with intersecting values.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "bf45b1"
    }
  },
  "required": [
    "format"
  ],
  "oneOf": [
    {
      "$ref": "#/definitions/metaPackage"
    },
    {
      "$ref": "#/definitions/concretePackage"
    }
  ],
  "definitions": {
    "semVer": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "variant": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)?$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "server",
        "client"
      ]
    },
    "runtime": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sources": {
      "description": "One source, or alternatives in order.",
      "oneOf": [
        {
          "$ref": "#/definitions/source"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source"
          }
        }
      ]
    },
    "templateSource": {
      "type": "string"
    },
    "range": {
      "type": "string"
    },
    "glob": {
      "description": "POSIX fnmatch patterns with FNM_PATHNAME and without FNM_PERIOD, matched segment by segment ('*', '?', bracket expressions; no escape character); a '**' segment matches zero or more segments; a trailing '/' matches directories and everything below them. A glob MUST NOT be empty, start with '/', or contain '//' or '\\'.",
      "type": "string"
    },
    "globs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/glob"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "path": {
      "description": "'/'-separated; MUST NOT start with '/' or with an ASCII letter and ':', or contain '//', a '..' segment or '\\'.",
      "type": "string"
    },
    "info": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "icon": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "dependency": {
      "oneOf": [
        {
          "$ref": "#/definitions/range"
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "$ref": "#/definitions/range"
            },
            "source": {
              "$ref": "#/definitions/sources"
            },
            "mod": {
              "type": "boolean"
            }
          },
          "if": {
            "properties": {
              "mod": {
                "const": false
              }
            },
            "required": [
              "mod"
            ]
          },
          "then": {
            "required": [
              "source"
            ]
          }
        }
      ]
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/id"
      },
      "additionalProperties": {
        "$ref": "#/definitions/dependency"
      }
    },
    "conflicts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/id"
      },
      "additionalProperties": {
        "$ref": "#/definitions/range"
      }
    },
    "loadOrder": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "const": "*"
          },
          {
            "$ref": "#/definitions/id"
          }
        ]
      }
    },
    "mod": {
      "type": "object",
      "properties": {
        "loader": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "passive": {
          "type": "boolean"
        },
        "loadAfter": {
          "$ref": "#/definitions/loadOrder"
        },
        "loadBefore": {
          "$ref": "#/definitions/loadOrder"
        },
        "extra": {
          "type": "object"
        }
      },
      "required": [
        "loader",
        "entry"
      ]
    },
    "file": {
      "description": "The glob form when src contains '*', '?' or '['; otherwise the directory form when src is \"\" or ends with '/'; otherwise the file form. In the glob and directory forms, dest MUST be \"\" or end with '/'; in the file form, it MUST NOT.",
      "type": "object",
      "properties": {
        "src": {
          "$ref": "#/definitions/path"
        },
        "dest": {
          "$ref": "#/definitions/path"
        }
      },
      "required": [
        "src",
        "dest"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/file"
      }
    },
    "hooks": {
      "type": "object",
      "properties": {
        "preInstall": {
          "$ref": "#/definitions/commands"
        },
        "postInstall": {
          "$ref": "#/definitions/commands"
        },
        "preUninstall": {
          "$ref": "#/definitions/commands"
        },
        "postUninstall": {
          "$ref": "#/definitions/commands"
        }
      }
    },
    "packageKeys": {
      "description": "The keys of a concrete package.",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "version": {
          "$ref": "#/definitions/semVer"
        },
        "platform": {
          "$ref": "#/definitions/platform"
        },
        "runtime": {
          "$ref": "#/definitions/runtime"
        },
        "info": {
          "$ref": "#/definitions/info"
        },
        "dependencies": {
          "$ref": "#/definitions/dependencies"
        },
        "conflicts": {
          "$ref": "#/definitions/conflicts"
        },
        "mod": {
          "$ref": "#/definitions/mod"
        },
        "files": {
          "$ref": "#/definitions/files"
        },
        "preserve": {
          "$ref": "#/definitions/globs"
        },
        "remove": {
          "$ref": "#/definitions/globs"
        },
        "hooks": {
          "$ref": "#/definitions/hooks"
        }
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "variant": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/definitions/variant"
            }
          ]
        },
        "platform": {
          "oneOf": [
            {
              "$ref": "#/definitions/platform"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/platform"
              }
            }
          ]
        },
        "runtime": {
          "oneOf": [
            {
              "$ref": "#/definitions/runtime"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/runtime"
              }
            }
          ]
        },
        "source": {
          "description": "One source, or alternatives in order.",
          "oneOf": [
            {
              "$ref": "#/definitions/templateSource"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/templateSource"
              }
            }
          ]
        },
        "id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/id"
            }
          ]
        },
        "version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/semVer"
            }
          ]
        },
        "info": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/info"
            }
          ]
        },
        "dependencies": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/dependencies"
            }
          ]
        },
        "conflicts": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/conflicts"
            }
          ]
        },
        "mod": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/mod"
            }
          ]
        },
        "files": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/files"
            }
          ]
        },
        "preserve": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/globs"
            }
          ]
        },
        "remove": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/globs"
            }
          ]
        },
        "hooks": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/hooks"
            }
          ]
        }
      },
      "required": [
        "source"
      ]
    },
    "metaPackage": {
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "version": {
          "$ref": "#/definitions/semVer"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/target"
          }
        }
      },
      "required": [
        "targets"
      ]
    },
    "concretePackage": {
      "allOf": [
        {
          "$ref": "#/definitions/packageKeys"
        },
        {
          "not": {
            "required": [
              "mod",
              "files"
            ]
          }
        }
      ],
      "not": {
        "required": [
          "targets"
        ]
      },
      "required": [
        "id",
        "version"
      ]
    }
  }
}
