{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LiteLDev/lip/raw/main/protocol/manifest.schema.json",
  "title": "lip manifest.json (format bf45b1)",
  "description": "Keys not described here are ignored. Two targets with the same variant must not write the same selector keys (platform, runtime) with intersecting values.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "bf45b1"
    }
  },
  "required": [
    "format"
  ],
  "if": {
    "required": [
      "targets"
    ]
  },
  "then": {
    "$ref": "#/definitions/metaPackage"
  },
  "else": {
    "$ref": "#/definitions/concretePackage"
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "server",
        "client"
      ]
    },
    "oneOrMore": {
      "description": "One string, or a non-empty array of them.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "globs": {
      "description": "POSIX fnmatch patterns with FNM_PATHNAME and without FNM_PERIOD, matched segment by segment ('*', '?', bracket expressions; no escape character); a '**' segment matches zero or more segments; a trailing '/' matches directories and everything below them. A glob MUST NOT be empty, start with '/', or contain '//' or '\\'.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "path": {
      "description": "'/'-separated; MUST NOT start with '/' or with an ASCII letter and ':', or contain '//', a '..' segment or '\\'.",
      "type": "string"
    },
    "metaPackage": {
      "properties": {
        "version": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "variant": {
                "type": "string",
                "pattern": "^([a-z0-9_]+(/[a-z0-9_]+)?)?$"
              },
              "platform": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/platform"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/definitions/platform"
                    }
                  }
                ]
              },
              "runtime": {
                "$ref": "#/definitions/oneOrMore"
              },
              "source": {
                "$ref": "#/definitions/oneOrMore"
              }
            },
            "required": [
              "source"
            ]
          }
        }
      }
    },
    "concretePackage": {
      "properties": {
        "name": {
          "$ref": "#/definitions/id"
        },
        "version": {
          "type": "string"
        },
        "platform": {
          "$ref": "#/definitions/platform"
        },
        "runtime": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "#/definitions/id"
              },
              "version": {
                "type": "string"
              },
              "source": {
                "$ref": "#/definitions/oneOrMore"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "#/definitions/id"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "description": "The glob form when src contains '*', '?' or '['; otherwise the directory form when src is \"\" or ends with '/'; otherwise the file form. In the glob and directory forms, dest MUST be \"\" or end with '/'; in the file form, it MUST NOT.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "$ref": "#/definitions/path"
              },
              "dest": {
                "$ref": "#/definitions/path"
              }
            },
            "required": [
              "src",
              "dest"
            ]
          }
        },
        "preserve": {
          "$ref": "#/definitions/globs"
        },
        "remove": {
          "$ref": "#/definitions/globs"
        },
        "hooks": {
          "type": "object",
          "properties": {
            "preInstall": {
              "$ref": "#/definitions/commands"
            },
            "postInstall": {
              "$ref": "#/definitions/commands"
            },
            "preUninstall": {
              "$ref": "#/definitions/commands"
            },
            "postUninstall": {
              "$ref": "#/definitions/commands"
            }
          }
        }
      },
      "required": [
        "name",
        "version"
      ],
      "dependencies": {
        "entry": [
          "type"
        ],
        "type": [
          "entry"
        ],
        "files": {
          "not": {
            "required": [
              "entry"
            ]
          }
        }
      }
    }
  }
}
