{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LiteLDev/lip/raw/main/protocol/state.schema.json",
  "title": "lip state.json (format 4)",
  "type": "object",
  "properties": {
    "format": {
      "const": 4
    },
    "side": {
      "enum": ["server", "client"]
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["server", "client"] }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "manifest": {
            "description": "The package file of the package.",
            "$ref": "lip.schema.toml"
          },
          "variant": {
            "type": "string"
          },
          "explicit": {
            "type": "boolean"
          },
          "ref": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["manifest", "variant", "explicit", "ref", "files"]
      }
    }
  },
  "required": ["format", "side", "platform", "packages"],
  "not": {
    "description": "The keys of lip before v0.40.",
    "required": ["runtime"]
  }
}
