{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LiteLDev/lip/raw/main/protocol/tooth.schema.json",
  "title": "lip tooth.json (format_version 4)",
  "description": "Keys not described here are ignored. Within a variant, no two entries have the same platform and runtime.",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 4
    },
    "format_uuid": {
      "const": "f74a5fda-cb2a-4de8-959f-a1a76bad3102"
    },
    "tooth": {
      "description": "A Go module path.",
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "info": {
      "description": "Information for people; not used by lip.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avatar_url": {
          "type": "string"
        }
      }
    },
    "variants": {
      "description": "Maps each variant name, \"\" for the default variant, to its entries.",
      "type": "object",
      "propertyNames": {
        "pattern": "^([a-z0-9_]+(/[a-z0-9_]+)?)?$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/definitions/entry"
        }
      }
    }
  },
  "required": [
    "format_version",
    "format_uuid",
    "tooth",
    "version",
    "variants"
  ],
  "definitions": {
    "platform": {
      "type": "string",
      "enum": [
        "server",
        "client"
      ]
    },
    "urls": {
      "description": "HTTPS URLs of the same file, tried in order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "path": {
      "description": "'/'-separated; MUST NOT start with '/' or with an ASCII letter and ':', or contain '//', a '..' segment or '\\'.",
      "type": "string"
    },
    "globs": {
      "description": "POSIX fnmatch patterns with FNM_PATHNAME and without FNM_PERIOD, matched segment by segment ('*', '?', bracket expressions; no escape character); a '**' segment matches zero or more segments; a trailing '/' matches directories and everything below them. A glob MUST NOT be empty, start with '/', or contain '//' or '\\'. Matched against paths relative to the workspace.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "placements": {
      "description": "The glob form when src contains '*', '?' or '['; otherwise the directory form when src is \"\" or ends with '/'; otherwise the file form. In the glob and directory forms, dest MUST be \"\" or end with '/'; in the file form, it MUST NOT. dest is relative to the workspace.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "$ref": "#/definitions/path"
          },
          "dest": {
            "$ref": "#/definitions/path"
          }
        },
        "required": [
          "src",
          "dest"
        ]
      }
    },
    "asset": {
      "oneOf": [
        {
          "description": "The archive of the tooth.json itself.",
          "properties": {
            "type": {
              "const": "self"
            },
            "placements": {
              "$ref": "#/definitions/placements"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "A ZIP archive downloaded from urls.",
          "properties": {
            "type": {
              "const": "zip"
            },
            "urls": {
              "$ref": "#/definitions/urls"
            },
            "placements": {
              "$ref": "#/definitions/placements"
            }
          },
          "required": [
            "type",
            "urls"
          ]
        },
        {
          "description": "A ZIP archive downloaded from urls, with a LeviLamina manifest.json at its root, written whole into mods/<the name in that manifest.json>/.",
          "properties": {
            "type": {
              "const": "mcmod"
            },
            "urls": {
              "$ref": "#/definitions/urls"
            }
          },
          "not": {
            "required": [
              "placements"
            ]
          },
          "required": [
            "type",
            "urls"
          ]
        }
      ]
    },
    "entry": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/definitions/platform"
        },
        "runtime": {
          "description": "A .NET runtime identifier.",
          "type": "string"
        },
        "dependencies": {
          "description": "Maps \"<tooth>\" or \"<tooth>#<variant>\" to a version range.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "assets": {
          "description": "At most one asset has the type \"mcmod\".",
          "type": "array",
          "items": {
            "$ref": "#/definitions/asset"
          }
        },
        "preserve_files": {
          "$ref": "#/definitions/globs"
        },
        "remove_files": {
          "$ref": "#/definitions/globs"
        },
        "hooks": {
          "type": "object",
          "properties": {
            "pre_install": {
              "$ref": "#/definitions/commands"
            },
            "post_install": {
              "$ref": "#/definitions/commands"
            },
            "pre_uninstall": {
              "$ref": "#/definitions/commands"
            },
            "post_uninstall": {
              "$ref": "#/definitions/commands"
            }
          }
        }
      },
      "required": [
        "platform",
        "runtime"
      ]
    }
  }
}
