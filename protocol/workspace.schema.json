{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LiteLDev/lip/raw/main/protocol/workspace.schema.json",
  "title": "lip workspace file (<workspace>/.lip/workspace.json), format bf45b1",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "bf45b1"
    },
    "platform": {
      "enum": ["server", "client", null]
    },
    "runtime": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/package"
      }
    }
  },
  "required": ["format", "packages"],
  "definitions": {
    "package": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "explicit": {
          "type": "boolean"
        },
        "chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string"
              },
              "target": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "required": ["ref", "target"]
          }
        },
        "archiveKey": {
          "type": "string"
        },
        "archive": {
          "description": "null when unknown (packages taken over from tooth_lock.json).",
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/zipArchive" },
            { "$ref": "#/definitions/gitArchive" },
            { "$ref": "#/definitions/directoryArchive" }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manifest": {
          "type": "object"
        }
      },
      "required": ["id", "version", "kind", "explicit", "chain", "archiveKey", "manifest"]
    },
    "zipArchive": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "zip"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": {
          "type": ["string", "null"]
        },
        "path": {
          "type": "string"
        }
      },
      "required": ["kind", "sha256", "url"]
    },
    "gitArchive": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "git"
        },
        "repo": {
          "type": "string",
          "pattern": "^https://.+\\.git$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string"
        }
      },
      "required": ["kind", "repo", "commit", "path"]
    },
    "directoryArchive": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "directory"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["kind", "path"]
    }
  }
}
