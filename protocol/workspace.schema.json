{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LiteLDev/lip/raw/main/protocol/workspace.schema.json",
  "title": "lip workspace.json (format_version 4)",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 4
    },
    "platform": {
      "enum": [
        "server",
        "client"
      ]
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "manifest": {
            "description": "The tooth file of the package, of format_version 4.",
            "$ref": "tooth.schema.json"
          },
          "variant": {
            "type": "string"
          },
          "explicit": {
            "type": "boolean"
          },
          "ref": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "manifest",
          "variant",
          "explicit",
          "ref",
          "files"
        ]
      }
    }
  },
  "required": [
    "format_version",
    "platform",
    "runtime",
    "packages"
  ]
}
